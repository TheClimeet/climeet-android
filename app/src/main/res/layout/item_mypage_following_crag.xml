<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cv_profile"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@drawable/oval_lightgreyfill_nostroke_noradius"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layout_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_following"
                style="@style/TextSmallSemiBold"
                android:layout_width="72dp"
                android:layout_height="30dp"
                android:background="@drawable/btn_follow"
                android:text="팔로잉"
                android:textColor="@color/white"
                android:visibility="visible" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_follow"
                style="@style/TextSmallSemiBold"
                android:layout_width="72dp"
                android:layout_height="30dp"
                android:background="@drawable/btn_following"
                android:text="팔로우"
                android:textColor="@color/black"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/cv_profile"
            app:layout_constraintEnd_toStartOf="@id/layout_btn"
            app:layout_constraintStart_toEndOf="@+id/cv_profile"
            app:layout_constraintTop_toTopOf="@+id/cv_profile"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvName"
                style="@style/TextRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="더클라임 클라이밍 강남점" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="팔로워"
                    android:textColor="@color/cm_grey_dark1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_follower"
                    style="@style/TextRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="100000"
                    android:textColor="@color/cm_grey_dark1"
                    android:textSize="14sp" />

                <TextView
                    style="@style/TextRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="| 팔로잉"
                    android:textColor="@color/cm_grey_dark1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_following"
                    style="@style/TextRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="1100000"
                    android:textColor="@color/cm_grey_dark1"
                    android:textSize="14sp"
                    tools:text="1100000" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>